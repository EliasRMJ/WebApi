{
  "openapi": "3.0.1",
  "info": {
    "title": "ServiceNow (WebApi)",
    "description": "APIs integradas de gerenciamento de execução de serviços.",
    "contact": {
      "name": "ServiceNow",
      "url": "https://api.servicenow.app.br",
      "email": "contact@servicenow.app.br"
    },
    "version": "v1"
  },
  "paths": {
    "/mail/send/organizations/{organizationCode}": {
      "patch": {
        "tags": [
          "Mail"
        ],
        "operationId": "PatchMail",
        "parameters": [
          {
            "name": "organizationCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailStruct"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnMessage"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnMessage"
                }
              }
            }
          }
        }
      }
    },
    "/mail/send/create-or-replace": {
      "post": {
        "tags": [
          "Mail"
        ],
        "operationId": "PostMail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailInfoViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnMessage"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnMessage"
                }
              }
            }
          }
        }
      }
    },
    "/version/numbers/{number}": {
      "get": {
        "tags": [
          "Version"
        ],
        "operationId": "GetVersion",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionView"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveEnum": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "EmailStruct": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          },
          "toName": {
            "type": "string",
            "nullable": true
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "userSsl": {
            "type": "boolean"
          },
          "mailAttachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MailAttachment"
            },
            "nullable": true
          },
          "messagePriority": {
            "$ref": "#/components/schemas/MessagePriority"
          }
        },
        "additionalProperties": false
      },
      "MailAttachment": {
        "type": "object",
        "properties": {
          "base64": {
            "type": "string",
            "nullable": true
          },
          "fileName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MailInfoViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isDelete": {
            "type": "boolean"
          },
          "isCheck": {
            "type": "boolean"
          },
          "isNew": {
            "type": "boolean",
            "readOnly": true
          },
          "isActive": {
            "type": "boolean"
          },
          "organizationCode": {
            "type": "string",
            "nullable": true
          },
          "identifyObject": {
            "type": "string",
            "format": "uuid"
          },
          "viewId": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "className": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "accountMail": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "$ref": "#/components/schemas/ActiveEnum"
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "secureConnection": {
            "$ref": "#/components/schemas/ActiveEnum"
          },
          "server": {
            "type": "string",
            "nullable": true
          },
          "urlLogo": {
            "type": "string",
            "nullable": true
          },
          "companyName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MessagePriority": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "ReturnMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VersionView": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "size": {
            "type": "number",
            "format": "double"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "urlDownload": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Insira o JWT como: Bearer {Seu token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}